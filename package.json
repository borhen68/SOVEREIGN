{
  "name": "sovereign-mvp",
  "version": "0.1.0",
  "description": "SOVEREIGN v1 MVP API - mission contracts, runtime policy, approvals, and closure metrics.",
  "type": "module",
  "main": "dist/src/server.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "openapi:export": "npm run build && node scripts/export-openapi.mjs",
    "dev": "npm run build && node --watch dist/src/server.js",
    "start": "npm run build && node dist/src/server.js",
    "worker": "npm run build && node dist/src/worker.js",
    "start:prod": "node dist/src/server.js",
    "worker:prod": "node dist/src/worker.js",
    "ui": "npm run build && node dist/src/cli/local-ui.js",
    "companion:macos": "npm run build && node dist/src/companion/macos-node.js",
    "test": "npm run build && node --test dist/test/*.test.js",
    "check": "npm run build && node --test dist/test/*.test.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^25.4.0",
    "prisma": "^6.19.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "pg": "^8.18.0",
    "redis": "^5.11.0"
  }
}
